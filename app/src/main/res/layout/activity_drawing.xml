<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:id="@+id/drawing_root">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_back"
            android:backgroundTint="#607D8B"
            android:textSize="14sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tvDrawTaskLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/draw_task_label"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvDrawTaskName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Substance Name"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#3F51B5"
        android:gravity="center"
        android:layout_marginBottom="2dp"/>

    <TextView
        android:id="@+id/tvDrawTaskFormula"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Formula"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp"/>

    <zeev.fraiman.assemblethemolecule.utils.DrawingView
        android:id="@+id/drawingCanvas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@android:color/white"
        android:elevation="2dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvElementPalette"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvAiFeedback"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="AI feedback will appear here"
        android:textSize="14sp"
        android:textColor="#3F51B5"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:visibility="gone"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/btnClearCanvas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Clear"
            android:layout_marginEnd="4dp"
            android:backgroundTint="#FF5722"/>

        <Button
            android:id="@+id/btnAnalyzeAi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Check with AI"
            android:layout_marginStart="4dp"
            android:backgroundTint="#4CAF50"/>
    </LinearLayout>

</LinearLayout>
